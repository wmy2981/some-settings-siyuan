{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "strictNullChecks": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["es2019", "dom"]
  },
  "include": [
    "src/**/*.ts",
    "feature-control.json"
  ]
}
