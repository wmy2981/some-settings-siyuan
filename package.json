{
  "name": "some-settings-siyuan",
  "version": "1.1.0",
  "description": "A SiYuan plugin that ships a batch of independently toggleable desktop and mobile enhancements",
  "main": "dist/index.js",
  "private": false,
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-features.mjs",
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "npm run check && webpack --config webpack.config.js --mode production",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.mts"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "settings",
    "思源插件",
    "some-settings"
  ],
  "author": "wmy2981",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^5.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "0.57.4",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^31.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.58.0",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.5",
    "siyuan": "1.2.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
