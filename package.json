{
  "name": "some-settings-siyuan",
  "version": "0.0.1",
  "description": "A SiYuan plugin that ships a batch of independently toggleable desktop and mobile enhancements",
  "main": "dist/index.js",
  "private": false,
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-features.mjs",
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "npm run check && webpack --config webpack.config.js --mode production"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "settings",
    "思源插件",
    "some-settings"
  ],
  "author": "wmy2981",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "latest",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.58.0",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.3",
    "siyuan": "1.2.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  }
}
